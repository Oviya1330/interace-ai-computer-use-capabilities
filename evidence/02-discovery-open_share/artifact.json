{
  "schemaVersion": "1.0.0",
  "id": "01M2XP0RA8V1Y2NHK6C1Z3ZZ20",
  "name": "member.open_share",
  "version": "1.0.0",
  "status": "draft",
  "title": "Open a new share (sub-account) for a member",
  "description": "Finds the member, fills the New Share form (type, description, initial deposit), reviews it and posts it, returning the confirmation number.",
  "goal": "Open a new {{share_type}} sub-account (share) for member {{member_id}} with a {{initial_deposit}} initial deposit and reach the confirmation screen",
  "app": {
    "profile": "legacycore-teller",
    "surface": "legacy_web",
    "family": "legacycore/teller-console@7"
  },
  "entry": {
    "url": {
      "kind": "template",
      "template": "{{base_url}}/"
    },
    "requiresSession": true
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "description": "Five-digit member number",
      "required": true,
      "pattern": "^\\d{5}$",
      "sensitivity": "pii"
    },
    "share_type": {
      "type": "string",
      "description": "Share product to open (Savings, {{share_type}}, Money Market)",
      "required": true,
      "example": "{{share_type}}",
      "sensitivity": "none"
    },
    "description": {
      "type": "string",
      "description": "Free-text description for the new share",
      "required": true,
      "example": "{{description}}",
      "sensitivity": "none"
    },
    "initial_deposit": {
      "type": "number",
      "description": "Initial deposit in USD (minimum 5.00), moved from the member's funding share",
      "required": true,
      "sensitivity": "financial"
    }
  },
  "outputs": {
    "confirmation_number": {
      "type": "string",
      "description": "Confirmation number of the posted share",
      "sensitivity": "none"
    }
  },
  "policy": {
    "riskClass": "irreversible",
    "sideEffects": "creates_record",
    "requiresApproval": true,
    "allowedOrigins": [
      "http://localhost:4173",
      "http://127.0.0.1:4173"
    ]
  },
