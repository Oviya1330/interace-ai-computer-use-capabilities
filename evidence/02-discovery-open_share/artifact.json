{
  "schemaVersion": "1.0.0",
  "id": "01M3F9KEWK8YSXBJBA1XZCCG1P",
  "name": "member.open_share",
  "version": "1.0.0",
  "status": "draft",
  "title": "Open a New Share (Sub-Account) for a Member",
  "description": "Opens a new share sub-account (e.g., {{share_type}}) for an existing member in LegacyCore Teller Console v7 and funds it with an initial deposit. The flow opens Member Inquiry, searches for the member by member number, opens the member record, starts a New Share, sets the share type, description and initial deposit amount, reviews, and confirms. Requires the member number, a share type that exactly matches an option in the 'Share Type' dropdown, a free-text description, and the initial deposit amount. Returns the confirmation number and the new share ID shown on the confirmation screen. This creates a new account record and posts a monetary deposit to it, so it should only be invoked with explicit authorization.",
  "goal": "Open a new {{share_type}} sub-account (share) for member {{member_id}} with a {{initial_deposit}} initial deposit and reach the confirmation screen",
  "app": {
    "profile": "legacycore-teller",
    "surface": "legacy_web",
    "family": "legacycore/teller-console@7"
  },
  "entry": {
    "url": {
      "kind": "template",
      "template": "{{base_url}}/"
    },
    "requiresSession": true
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "description": "Member number of the existing member who will own the new share (e.g., \"{{member_id}}\"). Used to search Member Inquiry and open the member record.",
      "required": true,
      "pattern": "^[0-9]+$",
      "sensitivity": "pii"
    },
    "share_type": {
      "type": "string",
      "description": "Type of share sub-account to open. Must exactly match an option in the 'Share Type' dropdown (e.g., \"{{share_type}}\").",
      "required": true,
      "example": "{{share_type}}",
      "sensitivity": "none"
    },
    "description": {
      "type": "string",
      "description": "Free-text description/nickname for the new share (e.g., \"{{description}}\").",
      "required": true,
      "example": "{{description}}",
      "sensitivity": "none"
    },
    "initial_deposit": {
      "type": "string",
      "description": "Initial deposit amount used to fund the new share, as a decimal with two places and no currency symbol (e.g., \"{{initial_deposit}}\").",
      "required": true,
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "sensitivity": "financial"
    }
  },
  "outputs": {
    "confirmation_number": {
      "type": "string",
      "description": "Confirmation number shown on the confirmation screen for the share opening (e.g., \"CNF-26C27DBE\").",
      "sensitivity": "none"
    },
    "share_id": {
      "type": "string",
      "description": "Identifier of the newly created share sub-account under the member (e.g., \"0030\"); kept as text to preserve leading zeros.",
      "sensitivity": "pii"
    }
  },
  "policy": {
    "riskClass": "irreversible",
    "sideEffects": "moves_money",
    "requiresApproval": true,
    "allowedOrigins": [
      "http://localhost:4173",
      "http://127.0.0.1:4173"
    ]
  },
