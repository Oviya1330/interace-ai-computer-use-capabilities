{
  "name": "cua-capabilities",
  "version": "0.1.0",
  "description": "Computer-use automation: LLM discovers a UI flow once, records it as a typed capability artifact, replays it deterministically with an explicit error taxonomy, and hands the live session to a human when stuck.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cua": "./bin/cua.js"
  },
  "scripts": {
    "app": "tsx apps/legacycore/server.ts",
    "cua": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:discover": "tsx scripts/demo.ts discover",
    "demo:replay": "tsx scripts/demo.ts replay",
    "demo:all": "tsx scripts/demo.ts all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
